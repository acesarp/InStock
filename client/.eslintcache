rningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"31","usedDeprecatedRules":"24"},{"filePath":"32","messages":"33","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"34","messages":"35","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"36","messages":"37","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"38","messages":"39","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"40"},{"filePath":"41","messages":"42","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"43","messages":"44","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"24"},"/Users/sallystrouble/Desktop/InStock/client/src/components/InventoryList.jsx",[],["45","46"],"/Users/sallystrouble/Desktop/InStock/client/src/index.js",[],"/Users/sallystrouble/Desktop/InStock/client/src/components/WarehouseList.jsx",[],"/Users/sallystrouble/Desktop/InStock/client/src/components/InventoryDetails.jsx",["47"],"import React, {Component} from 'react';\nimport axios from 'axios';\nimport \"../styles/main.css\";\nimport NavBar from './NavBar';\nimport SubHeader from './SubHeader';\n// import { Link } from 'react-router-dom';\n\n\nexport default class InventoryDetails extends Component {\n    url = 'http://localhost:5000';\n    iconFolder = `${process.env.PUBLIC_URL}/assets/Icons`;\n\n    constructor(){\n        super();\n        this.state ={\n            inventory:{}\n        }\n    }\n\n    componentDidMount() {\n        axios.get(`${this.url}/inventory/${this.props.match.params.id}`)\n            .then(response => {\n                \n                this.setState({ inventory: response.data[0]});\n            })\n            .catch(error => console.error(error));\n    }\n    // editHandler = () => {\n    //     axios.put(`${this.url}/inventory`, {\n    //             //STUB To Do\n    //             })\n    //         .then(response => {\n    //             this.setState(response.data);\n    //         })\n    //         .catch(error => console.error(error));\n    // }\n\n    render(){\n        console.log(this.state.inventory);\n        return(\n            <div className=\"bigbox\">\n                <NavBar />\n              <div className=\"section-wrapper\">\n                <div className =\"details__name\" >\n               \n                \n                    <SubHeader\n                        title={this.state.inventory.itemName}/>\n                    {/* <h2>{this.state.inventory.itemName}</h2> */}\n                <p className=\"details__name--edit\"> edit                 <p className=\"details__name--edit-text\"> Edit</p></p>\n                \n                \n                <img src={`${this.iconFolder}/edit.svg`}                                                        />\n\n                </div>               \n                <div className=\"details\">\n                    <div className=\"details__column\">\n                        <div>\n                            <p>ITEM DESCRIPTION:</p>\n                            <p>{this.state.inventory.description}</p>\n                        </div>\n                        <div>\n                            <p>CATEGORY:</p>\n                            <p>{this.state.inventory.category}</p>\n                        </div>\n                    </div>\n                    <div>\n                        <div className=\"details__row\">\n                            <div >\n                                <p>STATUS:</p>\n                                <p>\n                                    {this.state.inventory.status}\n                                </p>\n                            </div>\n                            <div>\n                              \n                                <p>QUANTITY:</p>\n                                <p>\n                                {this.state.inventory.quantity}\n                                </p>\n                            </div>\n                        </div>\n                        <div>\n                            <div>\n                            <p>WAREHOUSE:</p>\n                                <p>\n                                    {this.state.inventory.warehouseName}\n                                </p>\n                            </div>\n                    </div>\n                </div>\n\n                \n                </div>\n              \n                \n\n            </div>\n\n            </div>\n\n        );\n\n    }\n}\n","/Users/sallystrouble/Desktop/InStock/client/src/components/SubHeader.jsx",[],"/Users/sallystrouble/Desktop/InStock/client/src/components/DeleteModal.jsx",[],"/Users/sallystrouble/Desktop/InStock/client/src/components/NavBar.jsx",[],"/Users/sallystrouble/Desktop/InStock/client/src/components/AddEditInventory.jsx",[],["48","49"],"/Users/sallystrouble/Desktop/InStock/client/src/components/AddEditWarehouse.jsx",[],"/Users/sallystrouble/Desktop/InStock/client/src/components/WarehouseDetails.jsx",[],{"ruleId":"50","replacedBy":"51"},{"ruleId":"52","replacedBy":"53"},{"ruleId":"54","severity":1,"message":"55","line":53,"column":17,"nodeType":"56","endLine":53,"endColumn":115},{"ruleId":"50","replacedBy":"57"},{"ruleId":"52","replacedBy":"58"},"no-native-reassign",["59"],"no-negated-in-lhs",["60"],"jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement",["59"],["60"],"no-global-assign","no-unsafe-negation"]